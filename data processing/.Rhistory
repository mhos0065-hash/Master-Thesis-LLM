cat(" - figures/bivariate_moran_all_years.csv      (21 pairs x N years)\n")
cat("============================================================\n")
# =============================================================================
#  spatial_outlier_iterative_r_all_years.R
#  NEW TASK 4 (harder version): Iterative-r spatial outlier detection
#  (Lu, C.T., Chen, D., & Kou, Y. (2003). "Algorithms for spatial outlier
#  detection." Proceedings of the 3rd IEEE International Conference on
#  Data Mining (ICDM), 597-600.)
#
#  This SUPERSEDES spatial_outlier_z_all_years.R (the simple neighbor-
#  difference z-test) -- that method is too easy for LLMs to get right
#  (single subtraction + threshold), giving no discriminating power
#  between models. This version fixes the "masking" problem the simple
#  method suffers from: a true outlier can distort the very neighborhood
#  average used to detect it, hiding itself (or hiding/falsely-flagging
#  OTHER nearby locations -- "swamping"). Iterative-r fixes this by
#  fitting a regression, excluding likely outliers, then refitting.
#
#  Method (fixed at exactly ONE refit round, deliberately, for fair
#  comparison across models -- the original paper allows further rounds
#  until convergence, but a fixed single round keeps every LLM solving
#  the identical, unambiguous problem):
#    1. For each borough, compute its own value AND its neighbors'
#       average value (the spatial lag).
#    2. Fit OLS regression: own_value ~ neighbor_avg, using ALL boroughs.
#    3. Compute residuals, standardize into z-scores (pass 1).
#    4. Flag any borough with |z| > 1.96 in pass 1 as a CANDIDATE outlier.
#    5. Refit the SAME regression, this time EXCLUDING the candidates
#       flagged in step 4 -- this is the key step that avoids masking.
#    6. Apply this refined line to ALL boroughs (including the excluded
#       candidates) to get FINAL predicted values and residuals.
#    7. Standardize the final residuals into z-scores and classify:
#       |z| > 2.576 -> outlier (99%), |z| > 1.96 -> outlier (95%),
#       otherwise not significant.
#
#  Both pass-1 (naive) and final (post-refit) z-scores are saved, so you
#  can directly show real cases in your data where the refit CHANGED the
#  classification -- concrete evidence the masking correction matters.
#
#  SAFE FOR YOUR EXISTING PIPELINE: reads the same borough boundaries as
#  your other scripts (read-only), writes to NEW, distinctly-named output
#  files. Does not touch global_moran_*, local_moran_*, getisord_*,
#  bivariate_*, spatial_outlier_z_* (the simpler version), or
#  borough_adjacency.csv.
#
#  Input:  PREP/2021.csv, PREP/2022.csv, PREP/2023.csv (only 2023.csv
#          provided so far; add earlier years the same way, or trim
#          YEARS below to just "2023")
#
#  Output: figures/spatial_outlier_iterative_r_<year>.csv    (one per year)
#          figures/spatial_outlier_iterative_r_all_years.csv (stacked, all years)
# =============================================================================
library(sf)
library(spdep)
library(dplyr)
library(stringr)
library(tidyverse)
# ── Configuration ─────────────────────────────────────────────────────────
PREP         <- "sustainability/dataset"
YEARS        <- c("2021", "2022", "2023")   # trim to c("2023") if that's all you have right now
OUT_DIR      <- "figures"
Z_CANDIDATE  <- 1.96   # threshold for flagging a PASS-1 candidate to exclude before refitting
Z_THRESH_95  <- 1.96   # final significance threshold, 95%
Z_THRESH_99  <- 2.576  # final significance threshold, 99%
if (!dir.exists(OUT_DIR)) dir.create(OUT_DIR, recursive = TRUE)
IND_TO_COL <- c(
NO2       = "no2_annual_mean",
Gas       = "gas_kwh_per_consumer",
Energy    = "energy_kwh_per_capita",
GHG       = "ghg_tco2e_per_capita",
Transport = "transport_kwh_per_capita",
Crime     = "crime_per_1k",
Waste     = "waste_tonnes_per_capita"
)
indicators <- names(IND_TO_COL)
clean_borough <- function(x) {
x %>% str_to_title() %>%
str_replace("\\bAnd\\b",  "and")  %>%
str_replace("\\bUpon\\b", "upon") %>%
str_replace("\\bOf\\b",   "of")
}
# ── Load borough boundaries + standard Queen contiguity weights ───────────
boroughs_sf_raw <- st_read(
"https://github.com/LingruFeng/GIS_assessment/blob/main/London_Boroughs.gpkg?raw=true",
quiet = TRUE
)
boroughs_sf <- boroughs_sf_raw %>%
st_transform(4326) %>%
rename(geometry = geom) %>%
st_set_geometry("geometry") %>%
mutate(borough = clean_borough(name)) %>%
select(borough, geometry)
nb_queen <- poly2nb(boroughs_sf, queen = TRUE)
lw       <- nb2listw(nb_queen, style = "W", zero.policy = TRUE)
cat("Neighbour summary:\n")
print(summary(nb_queen))
# ── Iterative-r spatial outlier helper ─────────────────────────────────
compute_iterative_r_outlier <- function(sf_obj, col, lw) {
vals    <- sf_obj[[col]]
missing <- is.na(vals)
vals_imp <- vals
vals_imp[missing] <- mean(vals, na.rm = TRUE)
neighbor_avg <- lag.listw(lw, vals_imp, zero.policy = TRUE)
# --- pass 1: fit on everyone ---
fit1 <- lm(vals_imp ~ neighbor_avg)
resid1 <- residuals(fit1)
z1 <- as.numeric(scale(resid1))
# --- identify candidates to exclude before refitting ---
candidate <- abs(z1) > Z_CANDIDATE & !missing
# --- refit EXCLUDING candidates (this is the step that fixes masking) ---
if (sum(!candidate) >= 3) {   # need enough points left to fit a line
fit2 <- lm(vals_imp[!candidate] ~ neighbor_avg[!candidate])
intercept2 <- coef(fit2)[1]
slope2     <- coef(fit2)[2]
} else {
# fallback: if almost everyone got flagged, keep the pass-1 line
intercept2 <- coef(fit1)[1]
slope2     <- coef(fit1)[2]
}
# --- apply refined line to EVERYONE (including excluded candidates) ---
predicted_final <- intercept2 + slope2 * neighbor_avg
residual_final  <- vals_imp - predicted_final
z_final <- as.numeric(scale(residual_final))
outlier_type <- case_when(
missing               ~ "No data",
z_final >  Z_THRESH_99 ~ "Outlier - high (99%)",
z_final >  Z_THRESH_95 ~ "Outlier - high (95%)",
z_final < -Z_THRESH_99 ~ "Outlier - low (99%)",
z_final < -Z_THRESH_95 ~ "Outlier - low (95%)",
TRUE                    ~ "Not significant"
)
# flag cases where the refit actually changed the classification --
# concrete evidence of masking/swamping correction in your real data
was_flagged_pass1  <- abs(z1) > Z_THRESH_95 & !missing
is_flagged_final    <- outlier_type %in% c("Outlier - high (99%)", "Outlier - high (95%)",
"Outlier - low (99%)", "Outlier - low (95%)")
masking_correction <- case_when(
missing ~ "No data",
was_flagged_pass1 & !is_flagged_final ~ "Unmasked by refit (was flagged, now not)",
!was_flagged_pass1 & is_flagged_final ~ "Revealed by refit (was NOT flagged, now is)",
TRUE ~ "No change"
)
tibble(
borough              = sf_obj$borough,
own_value            = round(vals_imp, 4),
neighbor_avg         = round(neighbor_avg, 4),
z_score_pass1        = round(z1, 4),
z_score_final        = round(z_final, 4),
outlier_type         = outlier_type,
masking_correction   = masking_correction
)
}
# ── Main loop: one pass per year, all 7 indicators ─────────────────────
outlier_all_years <- list()
for (yr in YEARS) {
panel_path <- file.path(PREP, paste0(yr, ".csv"))
if (!file.exists(panel_path)) {
cat("\nSkipping", yr, "-- file not found:", panel_path, "\n")
next
}
cat("\n============================================================\n")
cat(" YEAR:", yr, "\n")
cat("============================================================\n")
panel_yr <- read_csv(panel_path, show_col_types = FALSE) %>%
mutate(borough = clean_borough(borough))
spatial_df <- boroughs_sf %>%
left_join(panel_yr %>% select(borough, all_of(unname(IND_TO_COL))), by = "borough")
outlier_yr <- lapply(indicators, function(ind) {
col <- IND_TO_COL[[ind]]
res <- compute_iterative_r_outlier(spatial_df, col, lw)
res %>% mutate(year = yr, Indicator = ind, .before = 1)
}) %>% bind_rows()
cat("\n--- Iterative-r outlier counts,", yr, "---\n")
print(outlier_yr %>% count(Indicator, outlier_type) %>%
pivot_wider(names_from = outlier_type, values_from = n, values_fill = 0))
cat("\n--- Masking correction cases,", yr, "(where the refit changed the answer) ---\n")
print(outlier_yr %>% filter(masking_correction != "No change", masking_correction != "No data") %>%
select(Indicator, borough, z_score_pass1, z_score_final, masking_correction))
write.csv(outlier_yr, file.path(OUT_DIR, paste0("spatial_outlier_iterative_r_", yr, ".csv")), row.names = FALSE)
outlier_all_years[[yr]] <- outlier_yr
}
outlier_all <- bind_rows(outlier_all_years)
write.csv(outlier_all, file.path(OUT_DIR, "spatial_outlier_iterative_r_all_years.csv"), row.names = FALSE)
cat("\n============================================================\n")
cat(" DONE. Saved:\n")
cat(" - figures/spatial_outlier_iterative_r_<year>.csv        (7 indicators x 33 boroughs each)\n")
cat(" - figures/spatial_outlier_iterative_r_all_years.csv      (7 indicators x 33 boroughs x N years)\n")
cat("============================================================\n")
# =============================================================================
#  getisord_all_years.R
#  NEW TASK 3: Getis-Ord Gi* hot-spot analysis (spdep::localG) -- the
#  standard method behind ArcGIS's "Hot Spot Analysis" tool. Two
#  foundational papers, cite both:
#    Getis, A. and Ord, J.K. (1992). "The analysis of spatial association
#      by use of distance statistics." Geographical Analysis, 24(3), 189-206.
#      (original G/G* statistic)
#    Ord, J.K. and Getis, A. (1995). "Local spatial autocorrelation
#      statistics: distributional issues and an application." Geographical
#      Analysis, 27(4), 286-306. (the LOCAL Gi/Gi* variant -- this is what
#      is actually computed below; note author order is Ord THEN Getis for
#      this specific paper, though the statistic is colloquially called
#      "Getis-Ord Gi*" in common usage).
#
#  Tests something genuinely DIFFERENT from
#  Local Moran's I: instead of asking "is this borough SIMILAR to its
#  neighbors" (Moran's I), Gi* asks "is there an unusually intense
#  CONCENTRATION of high (or low) values in this borough AND its
#  neighbors combined, regardless of similarity." A borough can show a
#  real Gi* hot spot even if it doesn't individually "match" any one
#  neighbor closely -- it's a magnitude/concentration test, not a
#  similarity test.
#
#  SAFE FOR YOUR EXISTING PIPELINE: reads the same borough boundaries as
#  moran_all_years.R (read-only), writes to NEW, distinctly-named output
#  files. Does not touch global_moran_*, local_moran_*, or
#  borough_adjacency.csv.
#
#  Input:  PREP/2021.csv, PREP/2022.csv, PREP/2023.csv (only 2023.csv
#          provided so far; add earlier years the same way, or trim
#          YEARS below to just "2023")
#
#  Output: figures/getisord_results_<year>.csv    (one per year, 7 indicators x 33 boroughs)
#          figures/getisord_results_all_years.csv (stacked, all years)
# =============================================================================
library(sf)
library(spdep)
library(dplyr)
library(stringr)
library(tidyverse)
# ── Configuration ─────────────────────────────────────────────────────────
PREP     <- "sustainability/dataset"
YEARS    <- c("2021", "2022", "2023")   # trim to c("2023") if that's all you have right now
OUT_DIR  <- "figures"
if (!dir.exists(OUT_DIR)) dir.create(OUT_DIR, recursive = TRUE)
IND_TO_COL <- c(
NO2       = "no2_annual_mean",
Gas       = "gas_kwh_per_consumer",
Energy    = "energy_kwh_per_capita",
GHG       = "ghg_tco2e_per_capita",
Transport = "transport_kwh_per_capita",
Crime     = "crime_per_1k",
Waste     = "waste_tonnes_per_capita"
)
indicators <- names(IND_TO_COL)
clean_borough <- function(x) {
x %>% str_to_title() %>%
str_replace("\\bAnd\\b",  "and")  %>%
str_replace("\\bUpon\\b", "upon") %>%
str_replace("\\bOf\\b",   "of")
}
# ── Load borough boundaries ─────────────────────────────────────────────
boroughs_sf_raw <- st_read(
"https://github.com/LingruFeng/GIS_assessment/blob/main/London_Boroughs.gpkg?raw=true",
quiet = TRUE
)
boroughs_sf <- boroughs_sf_raw %>%
st_transform(4326) %>%
rename(geometry = geom) %>%
st_set_geometry("geometry") %>%
mutate(borough = clean_borough(name)) %>%
select(borough, geometry)
# ── Two weight structures: standard (for reference) and SELF-INCLUDED
#    (required for Gi* specifically -- Gi* includes the focal borough in
#    its own neighborhood sum, unlike Local Moran's I) ─────────────────
nb_queen      <- poly2nb(boroughs_sf, queen = TRUE)
nb_queen_self <- include.self(nb_queen)          # Gi* requires this
lw_star       <- nb2listw(nb_queen_self, style = "W", zero.policy = TRUE)
cat("Neighbour summary (standard, for reference):\n")
print(summary(nb_queen))
# ── Getis-Ord Gi* helper ────────────────────────────────────────────────
compute_getis_ord <- function(sf_obj, col, lw_star) {
vals    <- sf_obj[[col]]
missing <- is.na(vals)
vals_imp <- vals
vals_imp[missing] <- mean(vals, na.rm = TRUE)
gi_star <- localG(vals_imp, lw_star, zero.policy = TRUE)
z <- as.numeric(gi_star)
# Standard critical values (Ord & Getis 1995): |z|>1.96 -> 95%, |z|>2.576 -> 99%
cluster <- case_when(
missing         ~ "No data",
z >  2.576      ~ "Hot spot (99%)",
z >  1.96       ~ "Hot spot (95%)",
z < -2.576      ~ "Cold spot (99%)",
z < -1.96       ~ "Cold spot (95%)",
TRUE            ~ "Not significant"
)
tibble(
borough  = sf_obj$borough,
gi_star_z = round(z, 4),
cluster  = cluster
)
}
# ── Main loop: one pass per year, all 7 indicators ─────────────────────
getisord_all_years <- list()
for (yr in YEARS) {
panel_path <- file.path(PREP, paste0(yr, ".csv"))
if (!file.exists(panel_path)) {
cat("\nSkipping", yr, "-- file not found:", panel_path, "\n")
next
}
cat("\n============================================================\n")
cat(" YEAR:", yr, "\n")
cat("============================================================\n")
panel_yr <- read_csv(panel_path, show_col_types = FALSE) %>%
mutate(borough = clean_borough(borough))
spatial_df <- boroughs_sf %>%
left_join(panel_yr %>% select(borough, all_of(unname(IND_TO_COL))), by = "borough")
getisord_yr <- lapply(indicators, function(ind) {
col <- IND_TO_COL[[ind]]
res <- compute_getis_ord(spatial_df, col, lw_star)
res %>% mutate(year = yr, Indicator = ind, .before = 1)
}) %>% bind_rows()
cat("\n--- Getis-Ord Gi* cluster counts,", yr, "---\n")
print(getisord_yr %>% count(Indicator, cluster) %>%
pivot_wider(names_from = cluster, values_from = n, values_fill = 0))
write.csv(getisord_yr, file.path(OUT_DIR, paste0("getisord_results_", yr, ".csv")), row.names = FALSE)
getisord_all_years[[yr]] <- getisord_yr
}
getisord_all <- bind_rows(getisord_all_years)
write.csv(getisord_all, file.path(OUT_DIR, "getisord_results_all_years.csv"), row.names = FALSE)
cat("\n============================================================\n")
cat(" DONE. Saved:\n")
cat(" - figures/getisord_results_<year>.csv        (7 indicators x 33 boroughs each)\n")
cat(" - figures/getisord_results_all_years.csv      (7 indicators x 33 boroughs x N years)\n")
cat("============================================================\n")
# =============================================================================
#  distance_decay_cyclehire.R
#  NEW TASK 2: Distance-decay (gravity model) analysis on real Cycle Hire
#  trip data. Tests whether trip volume between borough pairs falls off as
#  the distance between them increases -- the foundational relationship in
#  transportation geography (the "gravity model"). Foundational reference:
#    Wilson, A.G. (1971). "A family of spatial interaction models, and
#    associated developments." Environment and Planning A, 3(1), 1-32.
#  (the standard modern formalization of the gravity/spatial-interaction
#  model; the framework itself traces further back to Reilly 1929 and
#  Zipf 1946, but Wilson 1971 is the most commonly cited source for the
#  form used here). Uses REAL station
#  coordinates already present in your uploaded journeys_with_boroughs.csv
#  (StartLat/StartLon/EndLat/EndLon), which nothing in your pipeline has
#  used yet -- everything so far has only used the borough LABELS.
#
#  SAFE FOR YOUR EXISTING PIPELINE: reads journeys_with_boroughs.csv
#  read-only, writes to a NEW, distinctly-named output file. Does not
#  touch cyclehire_windows/, borough_adjacency.csv, or any Moran's I output.
#
#  Method: borough centroids are estimated as the mean lat/lon of all
#  stations within that borough (computed directly from real station data,
#  not looked up externally). For every ordered borough pair with at least
#  one real trip, compute the great-circle (haversine) distance between
#  centroids and the real trip count. Fit trips ~ distance in log-log form
#  (the standard gravity-model specification) and test the correlation.
#
#  Input:  journeys_with_boroughs.csv (same real file used throughout)
#  Output: figures/distance_decay_cyclehire.csv        (borough-pair level detail)
#          figures/distance_decay_summary.csv           (one row: overall test result)
# =============================================================================
library(dplyr)
library(tidyr)
library(readr)
library(stringr)
# ── Configuration ─────────────────────────────────────────────────────────
JOURNEYS_PATH <- "journeys_with_boroughs.csv"
OUT_DIR       <- "figures"
NSIM          <- 999
if (!dir.exists(OUT_DIR)) dir.create(OUT_DIR, recursive = TRUE)
clean_borough <- function(x) {
x %>% str_to_title() %>%
str_replace("\\bAnd\\b",  "and")  %>%
str_replace("\\bUpon\\b", "upon") %>%
str_replace("\\bOf\\b",   "of")
}
# ── Haversine great-circle distance (km), no external package needed ──────
haversine_km <- function(lat1, lon1, lat2, lon2) {
R <- 6371  # Earth radius, km
to_rad <- function(deg) deg * pi / 180
dlat <- to_rad(lat2 - lat1)
dlon <- to_rad(lon2 - lon1)
a <- sin(dlat / 2)^2 + cos(to_rad(lat1)) * cos(to_rad(lat2)) * sin(dlon / 2)^2
2 * R * asin(sqrt(pmin(1, a)))
}
# ── Load real journey data ──────────────────────────────────────────────
cat("Loading journeys...\n")
journeys <- read_csv(JOURNEYS_PATH, show_col_types = FALSE) %>%
rename(
StartStationId = `StartStation Id`, EndStationId = `EndStation Id`,
StartLat = StartLat, StartLon = StartLon, EndLat = EndLat, EndLon = EndLon
) %>%
mutate(StartBorough = clean_borough(StartBorough), EndBorough = clean_borough(EndBorough)) %>%
filter(!is.na(StartBorough), !is.na(EndBorough))
# =============================================================================
#  distance_decay_cyclehire.R
#  NEW TASK 2: Distance-decay (gravity model) analysis on real Cycle Hire
#  trip data. Tests whether trip volume between borough pairs falls off as
#  the distance between them increases -- the foundational relationship in
#  transportation geography (the "gravity model"). Foundational reference:
#    Wilson, A.G. (1971). "A family of spatial interaction models, and
#    associated developments." Environment and Planning A, 3(1), 1-32.
#  (the standard modern formalization of the gravity/spatial-interaction
#  model; the framework itself traces further back to Reilly 1929 and
#  Zipf 1946, but Wilson 1971 is the most commonly cited source for the
#  form used here). Uses REAL station
#  coordinates already present in your uploaded journeys_with_boroughs.csv
#  (StartLat/StartLon/EndLat/EndLon), which nothing in your pipeline has
#  used yet -- everything so far has only used the borough LABELS.
#
#  SAFE FOR YOUR EXISTING PIPELINE: reads journeys_with_boroughs.csv
#  read-only, writes to a NEW, distinctly-named output file. Does not
#  touch cyclehire_windows/, borough_adjacency.csv, or any Moran's I output.
#
#  Method: borough centroids are estimated as the mean lat/lon of all
#  stations within that borough (computed directly from real station data,
#  not looked up externally). For every ordered borough pair with at least
#  one real trip, compute the great-circle (haversine) distance between
#  centroids and the real trip count. Fit trips ~ distance in log-log form
#  (the standard gravity-model specification) and test the correlation.
#
#  Input:  journeys_with_boroughs.csv (same real file used throughout)
#  Output: figures/distance_decay_cyclehire.csv        (borough-pair level detail)
#          figures/distance_decay_summary.csv           (one row: overall test result)
# =============================================================================
library(dplyr)
library(tidyr)
library(readr)
library(stringr)
# ── Configuration ─────────────────────────────────────────────────────────
JOURNEYS_PATH <- "cycles/dataset/cyclehire_windows/journeys_with_boroughs.csv"
OUT_DIR       <- "figures"
NSIM          <- 999
if (!dir.exists(OUT_DIR)) dir.create(OUT_DIR, recursive = TRUE)
clean_borough <- function(x) {
x %>% str_to_title() %>%
str_replace("\\bAnd\\b",  "and")  %>%
str_replace("\\bUpon\\b", "upon") %>%
str_replace("\\bOf\\b",   "of")
}
# ── Haversine great-circle distance (km), no external package needed ──────
haversine_km <- function(lat1, lon1, lat2, lon2) {
R <- 6371  # Earth radius, km
to_rad <- function(deg) deg * pi / 180
dlat <- to_rad(lat2 - lat1)
dlon <- to_rad(lon2 - lon1)
a <- sin(dlat / 2)^2 + cos(to_rad(lat1)) * cos(to_rad(lat2)) * sin(dlon / 2)^2
2 * R * asin(sqrt(pmin(1, a)))
}
# ── Load real journey data ──────────────────────────────────────────────
cat("Loading journeys...\n")
journeys <- read_csv(JOURNEYS_PATH, show_col_types = FALSE) %>%
rename(
StartStationId = `StartStation Id`, EndStationId = `EndStation Id`,
StartLat = StartLat, StartLon = StartLon, EndLat = EndLat, EndLon = EndLon
) %>%
mutate(StartBorough = clean_borough(StartBorough), EndBorough = clean_borough(EndBorough)) %>%
filter(!is.na(StartBorough), !is.na(EndBorough))
cat("Real trips loaded:", nrow(journeys), "\n")
# ── Borough centroids: mean lat/lon of all stations actually in that
#    borough, computed directly from your real station data ──────────────
start_pts <- journeys %>% select(borough = StartBorough, lat = StartLat, lon = StartLon)
end_pts   <- journeys %>% select(borough = EndBorough,   lat = EndLat,   lon = EndLon)
all_pts   <- bind_rows(start_pts, end_pts) %>% filter(!is.na(lat), !is.na(lon))
centroids <- all_pts %>%
group_by(borough) %>%
summarise(centroid_lat = mean(lat), centroid_lon = mean(lon), n_points = n(), .groups = "drop")
cat("\nBorough centroids (from real station coordinates):\n")
print(centroids %>% select(borough, centroid_lat, centroid_lon))
# ── Build the borough-pair OD table: real trip counts + real distances ────
od_counts <- journeys %>%
filter(StartBorough != EndBorough) %>%   # cross-borough trips only -- distance-decay is
# about trips BETWEEN places, not within one
count(StartBorough, EndBorough, name = "n_trips")
od_table <- od_counts %>%
left_join(centroids %>% rename(start_lat = centroid_lat, start_lon = centroid_lon),
by = c("StartBorough" = "borough")) %>%
left_join(centroids %>% rename(end_lat = centroid_lat, end_lon = centroid_lon),
by = c("EndBorough" = "borough")) %>%
mutate(distance_km = haversine_km(start_lat, start_lon, end_lat, end_lon)) %>%
filter(distance_km > 0)  # drop any zero-distance artifacts
cat("\nBorough pairs with real trips:", nrow(od_table), "\n")
cat("Distance range (km):", round(min(od_table$distance_km), 2), "to", round(max(od_table$distance_km), 2), "\n")
write.csv(od_table, file.path(OUT_DIR, "distance_decay_cyclehire.csv"), row.names = FALSE)
# ── Gravity-model test: does log(trips) decline with log(distance)? ───────
# Standard log-log specification -- the real, established form used in
# transportation gravity models (trips ~ distance^-beta)
od_table_log <- od_table %>% mutate(log_trips = log(n_trips), log_distance = log(distance_km))
fit <- lm(log_trips ~ log_distance, data = od_table_log)
slope       <- round(coef(fit)[["log_distance"]], 4)
slope_pval  <- round(summary(fit)$coefficients["log_distance", "Pr(>|t|)"], 4)
r_squared   <- round(summary(fit)$r.squared, 4)
correlation <- round(cor(od_table_log$log_trips, od_table_log$log_distance), 4)
cat("\n--- Gravity model fit: log(trips) ~ log(distance) ---\n")
cat("Slope (beta):", slope, "| p-value:", slope_pval, "| R-squared:", r_squared,
"| Pearson correlation:", correlation, "\n")
interpretation <- case_when(
slope_pval < 0.05 & slope < 0 ~ "DISTANCE_DECAY_PRESENT -- trip volume significantly decreases with distance (real gravity-model relationship)",
slope_pval < 0.05 & slope > 0 ~ "POSITIVE_DISTANCE_RELATIONSHIP -- trip volume significantly INCREASES with distance (unusual, worth investigating)",
TRUE ~ "NO_DISTANCE_DECAY -- no significant relationship between trip volume and distance"
)
cat(interpretation, "\n")
summary_row <- tibble(
n_borough_pairs = nrow(od_table),
slope_beta      = slope,
slope_p_value   = slope_pval,
r_squared       = r_squared,
pearson_correlation = correlation,
significant     = if_else(slope_pval < 0.05, "Yes", "No"),
interpretation  = interpretation
)
write.csv(summary_row, file.path(OUT_DIR, "distance_decay_summary.csv"), row.names = FALSE)
cat("\n============================================================\n")
cat(" DONE. Saved:\n")
cat(" - figures/distance_decay_cyclehire.csv   (borough-pair level: trips, distance)\n")
cat(" - figures/distance_decay_summary.csv     (one row: overall test result)\n")
cat("============================================================\n")
