# Copy this file to .env and fill in your key.
# Free-tier option: https://console.groq.com (models: llama-3.3-70b-versatile, qwen/qwen3-32b, etc.)
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Minimum seconds between consecutive LLM calls, to stay under free-tier
# rate limits proactively. Groq's free tier is roughly 30 requests/minute,
# so 2.2s keeps you comfortably under that even with a bit of variance.
# If you hit rate-limit errors during a big run_experiment.py sweep, raise
# this (e.g. to 4). If you're on a paid tier with higher limits, you can
# lower it (e.g. to 0.5) to run faster.
LLM_MIN_INTERVAL_SECONDS=2.2
